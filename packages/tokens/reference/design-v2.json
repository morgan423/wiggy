      "journeeBouclee": ["0ms clôture: toast miel", "300ms pastilles reliées gauche→droite 120ms/segment", "900ms statement WONK: pop 450ms", "1350ms bilan: fondu 200ms — 1×/jour max"]
    }
  },
  "breakpoints": { "sm": 480, "md": 768, "lg": 1024, "xl": 1440 },
  "touch": { "hitMin": 44 },
