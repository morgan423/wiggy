# Supabase — projet région UE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role : serveur uniquement. Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Billing (G1) + Connect (B9)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sel du hachage des IP pour le rate limiting. Une chaîne aléatoire longue.
RATE_LIMIT_SALT=

# Google Cloud — Routes API (Compute Route Matrix). Serveur uniquement.
GOOGLE_ROUTES_API_KEY=

# Google Cloud - Places API (New), recherche d’hôtels pour A5. Facultative :
# sans elle, la cliente en séjour saisit son adresse à la main.
GOOGLE_PLACES_API_KEY=

# D7 : « developpement » ou « production ». Les scripts destructeurs
# refusent de tourner tant que ce n’est pas « developpement ».
WIGGY_ENV=developpement

# B7 : fournisseur SMS. Vide, aucun SMS ne part et le code de vérification
# est lisible dans le journal du serveur, en développement seulement.
SMS_FOURNISSEUR=

# C9 ③ — le push web. Sans ces deux clés, la matrice de notifications se règle
# mais RIEN NE PART, et l'écran le dit plutôt que de le laisser croire.
# Générer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
# La publique part dans le navigateur ; la privée ne quitte jamais le serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
