# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — motif NON ancré : un paquet du monorepo peut avoir le sien.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js — motifs NON ancrés : l'app vit dans apps/web, pas à la racine.
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le gabarit, lui, doit être versionné : c'est la doc des variables attendues.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fichier de transit pour les clés, jamais versionné.
CLES-A-REMPLIR.txt

# Fichier généré pour application manuelle des migrations.
MIGRATIONS-A-COLLER*.sql

# Captures produites par `npm run vues` : régénérables, jamais versionnées.
captures/

# Zips de resynchronisation, générés hors du dépôt.
wiggy-resync-*.zip
