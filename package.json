{
  "name": "wiggy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:check": "node scripts/db-check.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "web": "npm run dev --workspace @wiggy/web",
    "pro": "npm run start --workspace @wiggy/pro",
    "verify": "npm run tokens:build && npm run db:types && npm run db:check && npm run db:rejeu && npm run db:test && npm run db:matrice && npm run journal:inventaire && npm run design:check && npm run archi:check && npm run copy:manques && npm run check && npm test && npm run e2e && npm run pwa:check && npm run vues",
    "db:test": "node --test scripts/db-test.mjs",
    "db:bundle": "node scripts/db-bundle.mjs",
    "db:matrice": "node scripts/db-matrice.mjs",
    "tokens:build": "node packages/tokens/build.mjs",
    "design:check": "node scripts/design-check.mjs",
    "trajets:calibrage": "node scripts/trajets-calibrage.mjs",
    "db:types": "node scripts/db-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode",
    "prepare": "husky",
    "copy:extract": "node scripts/copy-extract.mjs",
    "copy:manques": "node scripts/copy-manques.mjs",
    "communes:import": "node scripts/communes-import.mjs",
    "photos:purge": "node scripts/photos-purge.mjs",
    "purge:compte": "node scripts/purge-compte.mjs",
    "e2e": "node scripts/e2e-tunnel.mjs",
    "verifier:vide": "node scripts/verifier-vide.mjs",
    "vues": "node scripts/vues.mjs",
    "archi:check": "node scripts/archi-check.mjs",
    "mesure:blocages": "node scripts/mesure-blocages.mjs",
    "db:rejeu": "node scripts/db-rejeu.mjs",
    "db:etat": "node scripts/db-etat.mjs",
    "journal:inventaire": "node scripts/journal-inventaire.mjs",
    "pwa:check": "node scripts/pwa-check.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.13",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
